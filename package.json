{
  "name": "dsh-sketchpad",
  "version": "0.1.0",
  "description": "A handwriting and diagram whiteboard for DeepSeek Harness: sketch on a floating canvas and attach the drawing to your message.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "docs",
    "screenshots.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "bmhty123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmhty123/dsh-sketchpad.git"
  },
  "homepage": "https://github.com/bmhty123/dsh-sketchpad#readme",
  "bugs": {
    "url": "https://github.com/bmhty123/dsh-sketchpad/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "whiteboard",
    "drawing",
    "canvas",
    "handwriting",
    "sketch"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react-dom",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  }
}
